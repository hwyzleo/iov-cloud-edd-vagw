<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <packaging>jar</packaging>

    <parent>
        <groupId>net.hwyz.iov.cloud.parent</groupId>
        <artifactId>service</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <groupId>net.hwyz.iov.cloud.edd</groupId>
    <artifactId>vagw</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <description>车辆接入网关</description>
    <name>vehicle-access-gateway</name>

    <properties>
        <spring-mqtt.version>5.3.2.RELEASE</spring-mqtt.version>
        <protobuf.version>3.25.5</protobuf.version>
        <!-- PAR-PROTO release（EDD-VAGW-DSN-CR-006 锁定） -->
        <par-proto.version>0.0.1-SNAPSHOT</par-proto.version>
    </properties>

    <dependencies>
        <!-- 框架: Kafka -->
        <dependency>
            <groupId>net.hwyz.iov.cloud.framework</groupId>
            <artifactId>framework-kafka-starter</artifactId>
            <version>${framework-kafka.version}</version>
        </dependency>
        <!-- 框架: MySQL -->
        <dependency>
            <groupId>net.hwyz.iov.cloud.framework</groupId>
            <artifactId>framework-mysql-starter</artifactId>
        </dependency>
        <!-- MQTT -->
        <dependency>
            <groupId>org.springframework.integration</groupId>
            <artifactId>spring-integration-mqtt</artifactId>
            <version>${spring-mqtt.version}</version>
        </dependency>
        <!-- Web: EMQX HTTP hooks and REST API -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Redis: session storage -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- Validation: request validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Protobuf: message support -->
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <version>${protobuf.version}</version>
        </dependency>
        <!-- PAR-PROTO: canonical 公共 Envelope（vehicle.common.v1.VehicleMessageEnvelope），
             VAGW 唯一 wire 契约来源，禁止引入 iov-cloud-proto-fota / 本地 Proto 副本 -->
        <dependency>
            <groupId>net.hwyz.iov.cloud.proto</groupId>
            <artifactId>proto-vehicle-common</artifactId>
            <version>${par-proto.version}</version>
        </dependency>
        <!-- PAR-PROTO: VAGW 云内技术投递状态（vagw.v1.Delivery.GatewayDeliveryStatus），
             独立跨服务契约，不进 common/fota，VAGW 不保存 delivery.proto / wire DTO / JSON fallback -->
        <dependency>
            <groupId>net.hwyz.iov.cloud.proto</groupId>
            <artifactId>proto-vagw</artifactId>
            <version>${par-proto.version}</version>
        </dependency>
        <!-- TSP API: device admission service -->
        <dependency>
            <groupId>net.hwyz.iov.cloud.iov</groupId>
            <artifactId>iov-tsp-api</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- 本地不再编译任何 .proto：wire 契约全部来自 PAR-PROTO artifacts（common + vagw）。 -->
    <build>
        <plugins>
            <!-- 覆盖 parent 默认 skip：本服务单元/集成测试真实执行（EDD-VAGW-DSN-CR-006） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>