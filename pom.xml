<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <packaging>jar</packaging>

    <parent>
        <groupId>net.hwyz.iov.cloud.parent</groupId>
        <artifactId>service</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <groupId>net.hwyz.iov.cloud.edd</groupId>
    <artifactId>vagw</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <description>车辆接入网关</description>
    <name>vehicle-access-gateway</name>

    <properties>
        <spring-mqtt.version>5.3.2.RELEASE</spring-mqtt.version>
        <protobuf.version>3.25.5</protobuf.version>
        <!-- PAR-PROTO release（EDD-VAGW-DSN-CR-006 锁定） -->
        <par-proto.version>0.0.1-SNAPSHOT</par-proto.version>
        <!--
            VMD CR-062 Keyprov API 版本（EDD-VAGW-DSN-CR-017）。
            本地开发可先由 iov-cloud-edd-vmd 执行 `mvn -pl edd-vmd-api install`；
            正式 release-set 必须替换为已发布、可追溯的非 SNAPSHOT 版本，
            禁止依赖开发机 Maven Local 或回退到旧 CR-059 artifact（启动 readiness 另行校验）。
        -->
        <edd-vmd-api.version>0.0.1-SNAPSHOT</edd-vmd-api.version>
        <testcontainers.version>1.19.8</testcontainers.version>
    </properties>

    <dependencies>
        <!-- 框架: Kafka -->
        <dependency>
            <groupId>net.hwyz.iov.cloud.framework</groupId>
            <artifactId>framework-kafka-starter</artifactId>
            <version>${framework-kafka.version}</version>
        </dependency>
        <!-- 框架: MySQL -->
        <dependency>
            <groupId>net.hwyz.iov.cloud.framework</groupId>
            <artifactId>framework-mysql-starter</artifactId>
        </dependency>
        <!-- MQTT -->
        <dependency>
            <groupId>org.springframework.integration</groupId>
            <artifactId>spring-integration-mqtt</artifactId>
            <version>${spring-mqtt.version}</version>
        </dependency>
        <!-- Web: EMQX HTTP hooks and REST API -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Redis: session storage -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- Validation: request validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Protobuf: message support -->
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <version>${protobuf.version}</version>
        </dependency>
        <!-- PAR-PROTO: canonical 公共 Envelope（vehicle.common.v1.VehicleMessageEnvelope），
             VAGW 唯一 wire 契约来源，禁止引入 iov-cloud-proto-fota / 本地 Proto 副本 -->
        <dependency>
            <groupId>net.hwyz.iov.cloud.proto</groupId>
            <artifactId>proto-vehicle-common</artifactId>
            <version>${par-proto.version}</version>
        </dependency>
        <!-- PAR-PROTO: VAGW 云内技术投递状态（vagw.v1.Delivery.GatewayDeliveryStatus），
             独立跨服务契约，不进 common/fota，VAGW 不保存 delivery.proto / wire DTO / JSON fallback -->
        <dependency>
            <groupId>net.hwyz.iov.cloud.proto</groupId>
            <artifactId>proto-vagw</artifactId>
            <version>${par-proto.version}</version>
        </dependency>
        <!-- PAR-PROTO: canonical keyprov wire（security.keyprov.v1 六类消息），
             VAGW 只做 Envelope 路由元数据 + 结构门禁 + 透明转发，不解析 Wrapped Key 密码学内容、
             不生成新 requestId（EDD-VAGW-DSN-CR-011，取代 DSN-CR-004 的 KMS 直连方案） -->
        <dependency>
            <groupId>net.hwyz.iov.cloud.proto</groupId>
            <artifactId>proto-keyprov</artifactId>
            <version>${par-proto.version}</version>
        </dependency>
        <!-- TSP API: device admission service -->
        <dependency>
            <groupId>net.hwyz.iov.cloud.iov</groupId>
            <artifactId>iov-tsp-api</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!-- VMD API: 官方 Keyprov Service Feign 契约（EDD-VAGW-DSN-CR-016 §2.4 / VMD-DSN-CR-059）。
             VAGW 直接注入官方 VmdKeyProvisioningService（request／ack／status 三端点），本地仅保留 Gateway Port/Adapter；
             不得依赖 edd-vmd-service 实现，不得复制 Feign 接口、URL、wire DTO 或 fallback。 -->
        <dependency>
            <groupId>net.hwyz.iov.cloud.edd</groupId>
            <artifactId>edd-vmd-api</artifactId>
            <version>${edd-vmd-api.version}</version>
        </dependency>
        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers: 真实 Redis 集成测试（DeviceOnlineOutboxStore readNew/claimStale 真实路径） -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- 本地不再编译任何 .proto：wire 契约全部来自 PAR-PROTO artifacts（common + vagw）。 -->
    <build>
        <plugins>
            <!-- 覆盖 parent 默认 skip：本服务单元/集成测试真实执行（EDD-VAGW-DSN-CR-006） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                    <!-- KeyprovProtocolLockTest 重新生成清单时与构建使用同一个 protoc 版本 -->
                    <systemPropertyVariables>
                        <keyprov.protoc.version>${protobuf.version}</keyprov.protoc.version>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <!--
                EDD-VAGW-DSN-CR-017 §4：从实际依赖制品生成只读 KeyprovProtocolLock 清单。
                只在 process-classes 写 target/generated-resources，绝不改写 src/main/resources 基线；
                输出确定性（无时间戳/绝对路径/用户名），CI 由 KeyprovProtocolLockTest 逐字节比对基线。
                更新基线属于显式协议升级，不得由普通构建自动完成。
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>generate-keyprov-protocol-lock</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>net.hwyz.iov.cloud.edd.vagw.build.KeyprovProtocolLockManifestGenerator</mainClass>
                            <classpathScope>compile</classpathScope>
                            <workingDirectory>${project.basedir}</workingDirectory>
                            <systemProperties>
                                <systemProperty>
                                    <key>keyprov.protoc.version</key>
                                    <value>${protobuf.version}</value>
                                </systemProperty>
                            </systemProperties>
                            <arguments>
                                <argument>${project.build.directory}/generated-resources/META-INF/vagw/keyprov-protocol-lock.json</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- 将生成的锁版清单放入运行时 classpath（覆盖仓库内审核基线副本）。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-generated-keyprov-protocol-lock</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.build.directory}/generated-resources</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>